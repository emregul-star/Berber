# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# .env.local git'e GİRMEZ; gizli anahtarları sadece orada tutun.

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
# Herkese açık anahtar (sb_publishable_...). Tarayıcıya gider; yetkiler RLS ile sınırlı.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GİZLİ anahtar (sb_secret_...). RLS'i atlar. SADECE sunucuda kullanılır, asla NEXT_PUBLIC_ ile başlamaz.
SUPABASE_SECRET_KEY=

# --- Platform ---
# Yerelde: localhost:3000  |  Yayında: ör. berberplatform.com veya berberplatform.vercel.app
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000
NEXT_PUBLIC_PLATFORM_NAME=BerberPlatform
# Alan adı olmadan (ücretsiz *.vercel.app adresinde) yayında "true":
# dükkanlar PLATFORM_DOMAIN/?shop=slug, süper yönetici PLATFORM_DOMAIN/admin adresinden açılır.
NEXT_PUBLIC_SINGLE_DOMAIN_MODE=false

# --- E-posta (Resend) ---
# Boşsa e-posta gönderilmez. Resend'de "Sending access" yetkili bir anahtar yeterlidir.
EMAIL_PROVIDER_API_KEY=
# Boşsa onboarding@resend.dev kullanılır (sadece test). Alan adı doğrulanınca ör. randevu@berberplatform.com
EMAIL_FROM=

# --- Panel girişi ---
# Supabase'e özel SMTP (alan adı gerekir) tanımlanınca "true" yapın: "Şifremi unuttum" e-postayla çalışır.
# Kapalıyken (ücretsiz kurulum) şifre sıfırlama yönetici/sahip tarafından geçici şifreyle yapılır.
AUTH_EMAILS_ENABLED=false
# "Şifremi unuttum" ve abonelik sayfasındaki destek WhatsApp numarası (905xxxxxxxxx, isteğe bağlı)
NEXT_PUBLIC_PLATFORM_SUPPORT_WHATSAPP=

# --- Demo dükkan panel hesapları (npm run demo:reset) ---
DEMO_OWNER_EMAIL=
DEMO_BARBER_EMAIL=
DEMO_BARBER_NAME=Can Kaya
# Verilirse her sıfırlamada şifreler bu değerlere ayarlanır ve demo panel girişinde
# "Dükkan sahibi / Berber olarak dene" butonları çıkar (şifreler sayfada gösterilmez).
DEMO_OWNER_PASSWORD=
DEMO_BARBER_PASSWORD=

# --- SMS (henüz uygulanmadı; ücretli servis — eklemeden önce maliyet konuşulmalı) ---
SMS_PROVIDER_API_KEY=

# --- Cloudflare Turnstile (isteğe bağlı; boşsa devre dışı) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Günlük demo sıfırlama (Vercel Cron, /api/cron/demo-reset) için rastgele uzun bir değer ---
# Üretmek için: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=
