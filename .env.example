# Bu dosyayı .env.local olarak kopyalayıp değerleri doldurun.
# .env.local git'e GİRMEZ; gizli anahtarları sadece orada tutun.

# --- Supabase (Project Settings -> API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=
# Herkese açık anahtar (sb_publishable_...). Tarayıcıya gider; yetkiler RLS ile sınırlı.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# GİZLİ anahtar (sb_secret_...). RLS'i atlar. SADECE sunucuda kullanılır, asla NEXT_PUBLIC_ ile başlamaz.
SUPABASE_SECRET_KEY=

# --- Platform ---
# Yerelde: localhost:3000  |  Yayında: ör. berberplatform.com
NEXT_PUBLIC_PLATFORM_DOMAIN=localhost:3000
NEXT_PUBLIC_PLATFORM_NAME=BerberPlatform

# --- E-posta (Resend) ---
# Boşsa e-posta gönderilmez. Resend'de "Sending access" yetkili bir anahtar yeterlidir.
EMAIL_PROVIDER_API_KEY=
# Boşsa onboarding@resend.dev kullanılır (sadece test). Alan adı doğrulanınca ör. randevu@berberplatform.com
EMAIL_FROM=

# --- SMS (henüz uygulanmadı; ücretli servis — eklemeden önce maliyet konuşulmalı) ---
SMS_PROVIDER_API_KEY=

# --- Cloudflare Turnstile (isteğe bağlı; boşsa devre dışı) ---
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Cron uç noktalarını korumak için rastgele uzun bir değer ---
CRON_SECRET=
